# انسخ هذا الملف باسم .env.local وحط فيه قيم مشروعك الفعلية.
# تلقى القيمتين في Supabase: Project Settings → API
# ملاحظة: .env.local مستثنى في .gitignore — لا ترفعه للمستودع أبداً.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# المشروع يشتغل ببيانات تجريبية إذا تُركت القيمتين فاضية.
# المفتاح anon مكشوف للمتصفح بطبيعته — الحماية الفعلية تجي من Row Level Security
# المفعّل في supabase/schema.sql، مو من إخفاء المفتاح.
