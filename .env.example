# انسخ هذا الملف باسم .env.local وحط فيه قيم مشروعك الفعلية.
# ملاحظة: .env.local مستثنى في .gitignore — لا ترفعه للمستودع أبداً.

# ---------------------------------------------------------------------------
# Supabase — إجباري
# ---------------------------------------------------------------------------
# تلقى القيمتين في: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# المفتاح anon مكشوف للمتصفح بطبيعته — وهذا طبيعي ومقصود.
# الحماية الفعلية من Row Level Security المفعّل في supabase/schema.sql،
# مو من إخفاء المفتاح.
#
# لا تضع مفتاح service_role هنا أبداً: أي متغير يبدأ بـ NEXT_PUBLIC_ يُرسل
# للمتصفح، و service_role يتخطى كل سياسات RLS.

# ---------------------------------------------------------------------------
# بيانات التواصل — اختيارية
# ---------------------------------------------------------------------------
# تظهر في صفحة «تواصل معنا». بدونها تظهر الحقول فارغة بدل أرقام وهمية.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# رقم واتساب بصيغة دولية بدون + أو مسافات، مثال: 9665xxxxxxxx
NEXT_PUBLIC_CONTACT_WHATSAPP=
