# Supabase — انسخ هذا الملف إلى .env.local وحدّث القيم
# Copy this file to .env.local and fill in your own project values.
# .env.local is gitignored; never commit real keys.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe to expose to the browser ONLY when Row Level
# Security is enabled on every table (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
